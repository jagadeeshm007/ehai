#!/bin/sh
# Conventional commits check. Enable once per clone: git config core.hooksPath .githooks
first=$(head -n1 "$1")
case "$first" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac
if ! printf '%s' "$first" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .+'; then
  echo "commit-msg: expected a conventional commit, e.g. 'feat(tracker): add Linear adapter'" >&2
  echo "            got: $first" >&2
  exit 1
fi
